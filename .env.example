# ---------------------------------------------------------------------------
# EvalOS environment configuration
#
# Copy this file to .env and adjust for your environment:
#   cp .env.example .env
#
# docker-compose.yml reads VITE_API_URL from this file automatically
# (docker compose loads a .env file in the project root by default).
# Everything else (DATABASE_URL, REDIS_URL, S3_*) is already wired to the
# in-network container hostnames inside docker-compose.yml and does not
# need to be set here for local development.
# ---------------------------------------------------------------------------

# The URL the BROWSER uses to reach the backend API. This is baked into the
# frontend's static JS bundle at BUILD time (Vite), not read at runtime --
# see Dockerfile.frontend. Changing this requires rebuilding the frontend
# image: `docker compose build frontend`.
#
# Local development (default): the browser and backend are both on your
# machine, so localhost is correct.
VITE_API_URL=http://localhost:8000/api/v1

# Production / hackathon deployment: point this at your deployed backend's
# public URL, e.g.:
# VITE_API_URL=https://evalos-backend.onrender.com/api/v1
